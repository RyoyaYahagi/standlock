    "Raise both arms overhead, interlace your fingers, and stretch upward. Hold for 15 seconds." : {
      "comment" : "Exercise description",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
