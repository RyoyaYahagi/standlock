    "NSLocationUsageDescription" : {
      "comment" : "Permission prompt shown by macOS.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Wi-Fi onlyが有効な場合に、接続中のWi-Fi名（SSID）を取得する目的だけで位置情報サービスを利用します。地理座標の取得、利用、保存は行いません。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLock uses Location Services only to read the current Wi-Fi network name (SSID) when Home Wi-Fi only is enabled. It does not read, use, or store geographic coordinates."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Permission prompt shown by macOS.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Wi-Fi onlyが有効な場合に、接続中のWi-Fi名（SSID）を取得する目的だけで位置情報サービスを利用します。地理座標の取得、利用、保存は行いません。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLock uses Location Services only to read the current Wi-Fi network name (SSID) when Home Wi-Fi only is enabled. It does not read, use, or store geographic coordinates."
          }
        }
      }
    }
