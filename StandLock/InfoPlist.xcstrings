    "NSAccessibilityUsageDescription" : {
      "comment" : "Permission prompt shown by macOS.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLock uses accessibility to block keyboard and mouse input during breaks in Strict mode."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLock, Katı modda molalar sırasında klavye ve fare girdisini engellemek için erişilebilirliği kullanır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLockはStrictモードの休憩中にキーボードとマウスの入力をブロックするため、アクセシビリティを使用します。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Permission prompt shown by macOS.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLock reads your calendar to defer breaks during meetings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandLock, toplantılarda molaları ertelemek için takviminizi okur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議中の休憩を延期するため、StandLockはカレンダーを読み取ります。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
